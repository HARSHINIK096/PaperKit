# MaskerV Backend Environment Variables
# Copy to .env and fill in your values

# MongoDB Atlas
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
DATABASE_NAME=maskerv

# JWT
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Providers (Google Gemini / Groq)
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# Frontend & Backend URLs (Render Production URLs)
FRONTEND_URL=https://maskerv-web.onrender.com
BACKEND_URL=https://maskerv-backend.onrender.com